{
  "private": true,
  "name": "@ttsc/evidence-benchmark",
  "version": "0.24.0",
  "description": "Agent benchmark for @ttsc/evidence: does an unattended agent actually satisfy a requirement, and what does enforcement cost.",
  "exports": {
    "./runner": "./src/EvidenceBenchmarkRunner.ts",
    "./workspace": "./src/EvidenceBenchmarkWorkspace.ts"
  },
  "scripts": {
    "audit-suspensions": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkSuspensionAudit.ts",
    "start": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkCommandLine.ts",
    "supervise": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkSupervision.ts",
    "warn": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkWarning.ts",
    "dashboard": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkDashboard.ts",
    "report": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkReport.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "ttsc": "workspace:*",
    "typescript": "catalog:typescript",
    "typia": "catalog:samchon",
    "yaml": "catalog:utils"
  }
}
