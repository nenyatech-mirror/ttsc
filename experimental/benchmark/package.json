{
  "private": true,
  "name": "@ttsc/experimental-benchmark",
  "version": "0.24.0",
  "description": "Performance and graph benchmark harnesses for ttsc.",
  "type": "module",
  "devDependencies": {
    "@types/node": "catalog:utils",
    "typescript": "catalog:typescript"
  },
  "scripts": {
    "check": "pnpm run check:source && tsc --noEmit -p tsconfig.json",
    "check:source": "node --experimental-transform-types src/executable/check-source-contract.ts",
    "performance": "node --experimental-transform-types src/executable/performance/index.ts",
    "performance:all": "node --experimental-transform-types src/executable/performance/index.ts",
    "performance:format": "node --experimental-transform-types src/executable/performance/index.ts --format-only",
    "performance:lint": "node --experimental-transform-types src/executable/performance/index.ts --lint-only",
    "performance:merge": "node --experimental-transform-types src/executable/performance/merge.ts",
    "performance:ttsc-build": "node --experimental-transform-types src/executable/performance/index.ts --ttsc-build-only",
    "graph": "node --experimental-transform-types src/executable/graph/index.ts",
    "graph:agent:claude": "node --experimental-transform-types src/executable/graph/agent-ab.ts",
    "graph:agent:codex": "node --experimental-transform-types src/executable/graph/agent-ab-codex.ts",
    "graph:analyze": "node --experimental-transform-types src/executable/graph/analyze-traces.ts",
    "graph:audit": "node --experimental-transform-types src/executable/graph/audit-codex-traces.ts",
    "graph:index": "node --experimental-transform-types src/executable/graph/index-time.ts",
    "graph:manifest": "node --experimental-transform-types src/executable/graph/generate-manifest.ts",
    "graph:publish": "node --experimental-transform-types src/executable/graph/publish.ts",
    "graph:reduce": "node --experimental-transform-types src/executable/graph/reduce.ts",
    "graph:structural": "node --experimental-transform-types src/executable/graph/bench.ts",
    "graph:suite": "node --experimental-transform-types src/executable/graph/run-suite.ts"
  }
}
